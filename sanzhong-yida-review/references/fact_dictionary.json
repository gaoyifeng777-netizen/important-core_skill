{
  "dictionary_version": "1.1",
  "schema_version": "1.1",
  "description": "四路独立事实提取字典；同名字段表达相同属性，来源身份、事实性质和阶段另行保留。",
  "item_shape": {
    "required": [
      "field",
      "raw",
      "normalized",
      "qualifiers",
      "evidence_indexes"
    ],
    "normalized": "string or null; decimal/integer use decimal string, not float",
    "evidence_indexes": "zero-based positions in the same record.evidence"
  },
  "fields": {
    "meeting.entity": {
      "label": "材料明示的会议所属单位",
      "roles": [
        "meeting_schedule",
        "meeting_record",
        "meeting_minutes"
      ],
      "value_type": "text",
      "qualifiers": {},
      "note": "不是主控任务对象的自动复制。"
    },
    "meeting.body": {
      "label": "会议机构/会议类型",
      "roles": [
        "meeting_schedule",
        "meeting_record",
        "meeting_minutes"
      ],
      "value_type": "text",
      "qualifiers": {},
      "note": "原文党委会、董事会、总经理办公会等；不自动视为同一机构。"
    },
    "meeting.number": {
      "label": "会议届次/次数",
      "roles": [
        "meeting_schedule",
        "meeting_record",
        "meeting_minutes"
      ],
      "value_type": "text",
      "qualifiers": {},
      "note": "保留届次、年度和次数原文；会议次数不作跨机构事项键。"
    },
    "meeting.location": {
      "label": "会议地点",
      "roles": [
        "meeting_schedule",
        "meeting_record",
        "meeting_minutes"
      ],
      "value_type": "text",
      "qualifiers": {},
      "note": ""
