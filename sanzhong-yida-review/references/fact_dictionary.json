    "financial.amount": {
      "label": "金额及其完整口径",
      "roles": [
        "meeting_schedule",
        "proposal_extract",
        "meeting_record",
        "meeting_minutes"
      ],
      "value_type": "decimal",
      "qualifiers": {
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "enum": [
            "元",
            "万元",
            "亿元",
            "unknown"
          ]
        },
        "amount_basis": {
          "type": [
            "string",
            "null"
          ],
          "description": "原文金额性质或计量口径，如投资上限、合同总价；不填项目名称或申请/批准状态。"
        },
        "scope_raw": {
          "type": [
            "string",
            "null"
          ],
          "description": "原文金额对应的项目、标的及一期/单包/年度等适用范围；只有投资上限等金额性质时为null。"
        },
        "tax_basis": {
          "type": "string",
          "enum": [
            "inclusive",
            "exclusive",
            "unknown"
          ]
        },
        "bound": {
          "type": "string",
          "enum": [
            "exact",
            "cap",
            "floor",
            "range",
            "approximate",
            "unknown"
          ]
        },
        "stage": {
          "type": "string",
          "enum": [
            "requested",
            "decision",
            "budget",
            "estimate",
            "historical",
            "actual_claim",
            "unknown"
          ],
          "description": "金额所处业务阶段；拟申请为requested，会议批准为decision，历史引述为historical，不由所在文件类型代定。"
        }
      },
      "note": "amount_basis为金额性质（如投资上限），scope_raw为金额对应的项目/标的及范围，stage为申请/决定等阶段；三者分别从原文落位，不互相代填。normalized只整理原数值字符串，不折成元；范围金额不取中点，normalized=null；货币未注明不得默认人民币。"
    },
