        "proposal_extract",
        "meeting_record",
        "meeting_minutes"
      ],
      "value_type": "text",
      "qualifiers": {},
      "note": "不把相似标题改成同一名称。"
    },
    "agenda.number": {
      "label": "本材料议题序号",
      "roles": [
        "meeting_schedule",
        "proposal_extract",
        "meeting_record",
        "meeting_minutes"
      ],
      "value_type": "text",
      "qualifiers": {},
      "note": "仅来源内顺序，不是全局事项编号。"
    },
    "matter.code": {
